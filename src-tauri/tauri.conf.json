{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ParallelADE",
  "version": "0.2.0",
  "identifier": "io.parallelade.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ParallelADE",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 400,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Run multiple Codex sessions. One lightweight workspace.",
    "category": "DeveloperTool",
    "icon": ["icons/icon.ico"]
  }
}
