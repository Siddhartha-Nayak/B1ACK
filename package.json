{
  "name": "parallelade",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "bundle": "tauri build",
    "test": "vitest run",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml --lib -- --test-threads=1",
    "format": "prettier --write src scripts *.json *.ts *.md",
    "format:check": "prettier --check src scripts *.json *.ts *.md",
    "test:desktop": "node scripts/iteration2-layout.mjs && node scripts/iteration2-workspaces.mjs && node scripts/iteration2-regressions.mjs",
    "test:stress": "node scripts/iteration2-stress.mjs",
    "test:app": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/validation-app.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  }
}
